{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futcheck.com/runner/actions/template-image.render/payload.schema.json",
  "title": "Template Image Render Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["template", "data", "output"],
  "properties": {
    "renderer": { "type": "string", "enum": ["svg", "playwright"], "default": "svg" },
    "template": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 240 },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#B6F23A" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "format"],
      "properties": {
        "path": { "type": "string", "default": "post.png" },
        "width": { "type": "integer", "minimum": 64, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 64, "maximum": 4096 },
        "format": { "const": "png" }
      }
    }
  }
}
