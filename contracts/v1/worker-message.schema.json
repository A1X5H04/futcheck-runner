{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futcheck.com/runner/contracts/v1/worker-message.schema.json",
  "title": "Futcheck Runner Worker Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "executionId", "jobId", "attempt", "platform", "platformRunId", "timestamp", "code", "message", "metadata"],
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "executionId": { "type": "string", "format": "uuid" },
    "jobId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "platformRunId": { "type": "string" },
    "timestamp": { "type": "integer", "minimum": 0 },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "metadata": { "type": "object" }
  }
}
