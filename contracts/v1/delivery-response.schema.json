{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futcheck.com/runner/contracts/v1/delivery-response.schema.json",
  "title": "Futcheck Runner Delivery Acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["acceptedEventIds", "acceptedMessageIds"],
  "properties": {
    "acceptedEventIds": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "uniqueItems": true
    },
    "acceptedMessageIds": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "uniqueItems": true
    },
    "abortJobs": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "uniqueItems": true,
      "default": []
    }
  }
}
