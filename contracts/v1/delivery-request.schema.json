{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futcheck.com/runner/contracts/v1/delivery-request.schema.json",
  "title": "Futcheck Runner Delivery Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["activeJobs", "events", "messages"],
  "properties": {
    "activeJobs": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": { "$ref": "event.schema.json" }
    },
    "messages": {
      "type": "array",
      "items": { "$ref": "worker-message.schema.json" }
    }
  },
  "anyOf": [
    { "properties": { "events": { "minItems": 1 } } },
    { "properties": { "messages": { "minItems": 1 } } }
  ]
}
