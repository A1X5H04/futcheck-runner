{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futcheck.com/runner/contracts/v1/action.schema.json",
  "title": "Futcheck Runner Action Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "description", "execution", "input", "output"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "defaultVariant", "variants"],
      "properties": {
        "entrypoint": { "type": "string" },
        "selector": { "type": "string" },
        "defaultVariant": { "type": "string" },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dockerfile", "resources"],
            "properties": {
              "dockerfile": { "type": "string" },
              "resources": {
                "type": "object",
                "additionalProperties": false,
                "required": ["memory", "cpus", "network"],
                "properties": {
                  "memory": { "type": "string" },
                  "cpus": { "type": "number", "exclusiveMinimum": 0 },
                  "network": { "type": "boolean" },
                  "shmSize": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadSchema", "jobFile", "directory"],
      "properties": {
        "payloadSchema": { "type": "string" },
        "jobFile": { "const": "/work/job.json" },
        "directory": { "const": "/work/input" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "manifest"],
      "properties": {
        "directory": { "const": "/work/output" },
        "manifest": { "const": "manifest.json" }
      }
    }
  }
}
