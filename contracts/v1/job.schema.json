{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futcheck.com/runner/contracts/v1/job.schema.json",
  "title": "Futcheck Runner Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "action", "actionVersion", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    },
    "actionVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "payload": { "type": "object" },
    "metadata": { "type": "object" }
  }
}
